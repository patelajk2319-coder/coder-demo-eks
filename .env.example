# Copy to .env and fill in the values below. .env is gitignored — never commit it.
# Everything in this file is either something YOU must set, or something the
# deploy scripts write automatically — each is labelled below.

# ── AWS ────────────────────────────────────────────────────────────────────────
# Uses the standard AWS credential chain (~/.aws/config, ~/.aws/credentials, or
# whatever AWS_PROFILE points at). If AWS_PROFILE is SSO-backed (has an
# sso_session in ~/.aws/config), `task login` runs `aws sso login` for you —
# no need to paste temporary keys in here.
AWS_REGION=eu-west-1
AWS_PROFILE=default

# ── Coder ──────────────────────────────────────────────────────────────────────
CODER_ADMIN_EMAIL=admin@coder.demo
CODER_ADMIN_PASSWORD=
CODER_VERSION=2.33.6
# Auto-populated by `task coder` once the internal NLB hostname is assigned —
# leave blank on first deploy.
CODER_ACCESS_URL=

# ── PostgreSQL (Amazon RDS) ──────────────────────────────────────────────────────
# TF_VAR_ prefix exposes the value directly to Terraform as a variable.
TF_VAR_postgres_admin_password=
POSTGRES_ADMIN_USER=pgadmin

# ── AI provider ──────────────────────────────────────────────────────────────────
# Stored in AWS Secrets Manager by `task infra` — never passed to Coder's own
# Terraform. Can be a placeholder value if you don't need AI Bridge features
# yet; rotate in the real key later with:
#   task rotate-secret SECRET_NAME=anthropic-api-key SECRET_VALUE=sk-ant-...
ANTHROPIC_API_KEY=

# ── Auto-populated by `task infra` — leave blank, do not edit manually ────────
EKS_CLUSTER_NAME=
RDS_ENDPOINT=
RDS_DATABASE=
SECRETS_MANAGER_ARN=
CODER_IDENTITY_ROLE_ARN=
