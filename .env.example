# Copy to .env and fill in values before running any tasks.
# .env is gitignored — never commit it.

# ── AWS ────────────────────────────────────────────────────────────────────────
# Uses the standard AWS credential chain (~/.aws/config, ~/.aws/credentials, or
# whatever AWS_PROFILE points at). If AWS_PROFILE is SSO-backed (has an
# sso_session in ~/.aws/config), `task login` runs `aws sso login` for you —
# no need to paste temporary keys in here.
AWS_REGION=eu-west-1
AWS_PROFILE=default

# ── Coder ──────────────────────────────────────────────────────────────────────
# CODER_ACCESS_URL is written by 20_deploy_coder.sh once the internal NLB
# hostname is assigned. Set it manually here if you already know it (e.g. on re-deploys).
CODER_ACCESS_URL=
CODER_ADMIN_EMAIL=admin@coder.demo
CODER_ADMIN_PASSWORD=
CODER_VERSION=2.33.6

# ── PostgreSQL (Amazon RDS) ──────────────────────────────────────────────────────
# TF_VAR_ prefix exposes the value directly to Terraform as a variable.
TF_VAR_postgres_admin_password=
POSTGRES_ADMIN_USER=pgadmin

# ── AI provider ──────────────────────────────────────────────────────────────────
# Stored in AWS Secrets Manager during task infra — never passed to Coder Terraform.
ANTHROPIC_API_KEY=

# ── Written by 10_deploy_core_infra.sh — do not edit manually ─────────────────
EKS_CLUSTER_NAME=
RDS_ENDPOINT=
RDS_DATABASE=
SECRETS_MANAGER_ARN=
CODER_IDENTITY_ROLE_ARN=
